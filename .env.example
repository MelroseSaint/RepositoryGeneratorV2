# Firebase Configuration
# Create a Firebase project at https://console.firebase.google.com/
# and add a web app to get these values

VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# AI Provider API Keys
# At least one provider is required for AI features

# OpenAI API Key
OPENAI_API_KEY=your-openai-api-key

# Anthropic API Key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Google Gemini API Key
GOOGLE_API_KEY=your-gemini-api-key

# Optional: Multiple keys for load balancing
# OPENAI_API_KEY_1=your-openai-api-key-2
# OPENAI_API_KEY_2=your-openai-api-key-3
# ANTHROPIC_API_KEY_1=your-anthropic-api-key-2
# ANTHROPIC_API_KEY_2=your-anthropic-api-key-3
# GOOGLE_API_KEY_1=your-gemini-api-key-2
# GOOGLE_API_KEY_2=your-gemini-api-key-3